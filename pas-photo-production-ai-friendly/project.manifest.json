{
  "project": "Pas Foto Production Manager",
  "version": "2.3.0",
  "purpose": "Internal CEP panel for pas-photo production workflow",
  "runtime": {
    "host": "Adobe Illustrator",
    "baseline": "2021 / 25.4.1",
    "cep": "10 / CSXS 10",
    "language": [
      "HTML",
      "CSS",
      "JavaScript ES5",
      "ExtendScript"
    ]
  },
  "source_of_truth": "src/extension",
  "build_output": "dist/extension",
  "entrypoints": {
    "manifest": "src/extension/CSXS/manifest.xml",
    "panel": "src/extension/client/index.html",
    "host": "src/extension/host/main.jsx"
  },
  "globals": {
    "panel": [
      "PFState",
      "PFBridge",
      "PFLayout"
    ],
    "host": [
      "PFPM"
    ]
  },
  "commands": [
    "createDocument",
    "generate",
    "ungroupAll",
    "selectionInfo",
    "nudge",
    "crop",
    "flip",
    "rotate90",
    "replacePhoto",
    "duplicateSlot",
    "deleteSlot",
    "undo",
    "pickFiles",
    "fromSelection",
    "docInfo",
    "ping"
  ],
  "high_risk_boundaries": [
    "PFState.buildJob",
    "PFLayout.generate",
    "PFBridge.call",
    "PFPM.* payloads",
    "Illustrator item metadata",
    "index.html script load order"
  ],
  "architecture_note": "Host entry point remains monolithic for ExtendScript compatibility; do not split without a proven loading strategy."
}
